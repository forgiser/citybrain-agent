{
  "name": "citybrain",
  "version": "0.1.0",
  "private": true,
  "description": "A Pi-style terminal shell for future urban geospatial data workflows.",
  "type": "module",
  "bin": {
    "citybrain": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.85.1",
    "commander": "14.0.0",
    "openai": "6.40.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
