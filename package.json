{
  "name": "citybrain-agent",
  "version": "0.1.0",
  "description": "面向空间数据处理、分析与可视化的本地智能体",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "PUBLISHING.md",
    "docs"
  ],
  "bin": {
    "citybrain": "dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgiser/citybrain-agent.git"
  },
  "homepage": "https://github.com/forgiser/citybrain-agent#readme",
  "bugs": {
    "url": "https://github.com/forgiser/citybrain-agent/issues"
  },
  "keywords": [
    "agent",
    "gis",
    "qgis",
    "geospatial",
    "maplibre",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "predev": "npm run build:web",
    "dev": "tsx src/main.ts",
    "dev:cli": "tsx src/main.ts --mode cli",
    "dev:web": "concurrently \"vite --config web/vite.config.ts\" \"tsx watch src/main.ts --mode web --no-open\"",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "check": "npm run typecheck && npm run typecheck:web",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.85.1",
    "@fastify/static": "^10.1.5",
    "3d-tiles-renderer": "^0.5.3",
    "commander": "14.0.0",
    "fastify": "^5.12.5",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.13.0",
    "maplibre-gl-three": "^3.0.2",
    "openai": "6.40.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
